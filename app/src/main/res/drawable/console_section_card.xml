<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D0223D64" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#A66FA8F4" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC1A3357" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#B36FA8F4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A914243C" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#3D7893C1" />
        </shape>
    </item>
</selector>
