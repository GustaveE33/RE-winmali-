<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#823D5A" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#CC9A4267" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#66304A" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#CC9A4267" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/community_config_surface" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#669A4267" />
        </shape>
    </item>
</selector>
